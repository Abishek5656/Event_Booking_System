{
	"info": {
		"name": "Event Booking System (Auto-Auth)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Auth & Login",
			"item": [
				{
					"name": "Login as Organizer (Auto-Sets Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.data && jsonData.data.token) {",
									"    pm.globals.set(\"jwt_token\", jsonData.data.token);",
									"    console.log(\"Organizer Token saved as Global Variable!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@techevents.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/v1/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "auth", "login"]
						}
					}
				},
				{
					"name": "Login as Customer (Auto-Sets Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData && jsonData.data && jsonData.data.token) {",
									"    pm.globals.set(\"jwt_token\", jsonData.data.token);",
									"    console.log(\"Customer Token saved as Global Variable!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"abishekvarma8929@gmail.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/v1/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "auth", "login"]
						}
					}
				},
				{
					"name": "Register New Customer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Charlie NewUser\",\n  \"email\": \"charlie@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/v1/auth/register",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "auth", "register"]
						}
					}
				},
				{
					"name": "Register New Organizer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Organizer User\",\n  \"email\": \"abishekvarma+org@gmail.com\",\n  \"password\": \"password123\",\n  \"role\": \"ORGANIZER\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/v1/auth/register",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "auth", "register"]
						}
					}
				}
			]
		},
		{
			"name": "2. Events",
			"item": [
				{
					"name": "Create Event (Requires Organizer)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Tech Conference 2026\",\n  \"description\": \"A grand conference about future technologies.\",\n  \"venue\": \"San Jose Convention Center\",\n  \"eventDate\": \"2026-12-01T10:00:00.000Z\",\n  \"totalSeats\": 100\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/v1/events",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "events"]
						}
					}
				},
				{
					"name": "Get All Events (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/api/v1/events",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "events"]
						}
					}
				},
				{
					"name": "Get Event By ID (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/api/v1/events/1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "events", "1"]
						}
					}
				},
				{
					"name": "Update Event (Requires Organizer)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"totalSeats\": 150\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/v1/events/1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "events", "1"]
						}
					}
				}
			]
		},
		{
			"name": "3. Bookings",
			"item": [
				{
					"name": "Create Booking (Requires Customer)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"eventId\": 1,\n  \"ticketsCount\": 2\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/v1/bookings",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "bookings"]
						}
					}
				},
				{
					"name": "Get My Bookings (Requires Customer)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:3000/api/v1/bookings/my-bookings",
							"protocol": "http",
							"host": ["localhost"],
							"port": "3000",
							"path": ["api", "v1", "bookings", "my-bookings"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	]
}
